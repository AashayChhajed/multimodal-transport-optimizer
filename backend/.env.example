# Backend Environment Variables
# Copy to backend/.env and fill in values (never commit .env)

# Database (NeonDB)
DB_URL=jdbc:postgresql://your-host/neondb?user=your_user&password=your_password&sslmode=require&channelBinding=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seed control
APP_SEED_ENABLED=true
