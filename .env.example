# ============================================
# Backend Environment Variables
# ============================================
# Database (NeonDB / PostgreSQL)
DB_URL=jdbc:postgresql://your-host/neondb?user=your_user&password=your_password&sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seed control (set to true on first deploy)
APP_SEED_ENABLED=true

# ============================================
# Frontend Environment Variables
# ============================================
# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# ============================================
# ML Service (Phase 4+)
# ============================================
# ML inference service URL (used by Spring Boot backend)
ML_SERVICE_URL=http://localhost:5000

# ML service timeout in milliseconds (default: 5000)
ML_SERVICE_TIMEOUT=5000

# ML service port (used by the Python Flask service)
ML_SERVICE_PORT=5000
